{
  "name": "asyncdb",
  "version": "1.0.0",
  "description": "a promisified wrapper for indexedDB",
  "files": [
    "dist/**/*"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KiranMantha/asyncdb.git"
  },
  "author": "KiranMantha",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/KiranMantha/asyncdb/issues"
  },
  "homepage": "https://github.com/KiranMantha/asyncdb#readme",
  "devDependencies": {
    "indexeddb-export-import": "^2.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
